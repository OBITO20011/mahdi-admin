# Gemini is used only by the protected Supabase Edge Function.
# Never add GEMINI_API_KEY to this browser environment file or any VITE_ variable.
# Configure it securely as a Supabase Edge Function secret named GEMINI_API_KEY.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
