{
  "name": "nawasrah-customer-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3002",
    "build": "vite build && node scripts/generate-seo-pages.mjs && node scripts/verify-seo-output.mjs",
    "deploy:cloudflare": "node ../scripts/environments/assert-production-context.mjs && npm run build:production && node ../scripts/environments/verify-dist.mjs customer production dist && wrangler pages deploy dist --project-name=nawasrah-store --branch=main",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "dev:lan": "vite --host 0.0.0.0 --port 3002",
    "build:production": "node ../scripts/environments/run-context.mjs production customer",
    "build:staging": "node ../scripts/environments/run-context.mjs staging customer",
    "build:prelaunch-trial": "node ../scripts/environments/run-context.mjs prelaunch-trial customer",
    "deploy:prelaunch-trial": "node ../scripts/deployment/deploy-prelaunch-trial.mjs customer"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "6.4.4",
    "wrangler": "^4.120.0"
  }
}
