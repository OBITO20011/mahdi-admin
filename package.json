{
  "name": "nawasrah-erp-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:eslint:strict": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:db:isolated": "node scripts/testing/bootstrap-isolated-supabase.mjs",
    "quality": "npm run lint && npm test && npm --prefix customer-web run lint && npm --prefix customer-web test && npm run build && npm --prefix customer-web run build && npm run test:e2e",
    "backup:preflight": "node scripts/backup/preflight.mjs",
    "backup:setup": "node scripts/backup/run-powershell-script.mjs scripts/backup/setup-backup.ps1",
    "backup:update-password": "node scripts/backup/run-powershell-script.mjs scripts/backup/update-database-password.ps1",
    "backup:run": "node scripts/backup/run-powershell-script.mjs scripts/backup/run-backup.ps1",
    "backup:verify": "node scripts/backup/run-powershell-script.mjs scripts/backup/verify-latest-backup.ps1",
    "backup:restore-test": "node scripts/backup/run-powershell-script.mjs scripts/backup/run-restore-drill.ps1",
    "backup:restore-schedule": "node scripts/backup/run-powershell-script.mjs scripts/backup/run-scheduled-restore-drill.ps1",
    "backup:status": "node scripts/backup/run-powershell-script.mjs scripts/backup/get-backup-status.ps1",
    "backup:schedule": "node scripts/backup/run-powershell-script.mjs scripts/backup/enable-background-backup.ps1",
    "backup:background": "node scripts/backup/run-powershell-script.mjs scripts/backup/enable-background-backup.ps1"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.3"
  }
}
