      {
        "id": "16357f1c-efc2-4536-9448-f684e8f82935",
        "name": "Format Owner Message",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          3360,
          0
        ],
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "5713a401-289d-4b0f-a3ae-cbfac365dfab",
                "name": "messageText",
                "value": "={{ (() => {\n const p=$json.payload||{},t=$json.eventType;\n const clean=v=>String(v??'—').replace(/[\\u0000-\\u001f\\u007f]/g,' ').slice(0,160).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n const money=v=>v===null||v===undefined||!Number.isFinite(Number(v))?'غير متاح':(Number(v)/1000).toFixed(3)+' د.أ';\n const labels={order_unprocessed:'طلب متأخر',order_near_expiry:'طلب قريب من انتهاء الحجز',order_expired:'انتهت مهلة طلب',shift_close_reminder:'تذكير إغلاق وردية',shift_close_overdue:'وردية متأخرة عن الإغلاق',purchase_order_overdue:'أمر شراء متأخر',expense_daily_threshold:'تجاوز حد المصروف اليومي',low_stock:'مخزون منخفض',out_of_stock:'نفد المخزون',new_order:'طلب متجر جديد',shift_closed:'أُغلقت الوردية',business_daily_summary:'ملخص اليوم',business_weekly_summary:'ملخص الأسبوع',cheque_due:'استحقاق شيك',cheque_returned:'شيك راجع'};\n let lines=[];\n if(t==='business_daily_summary'||t==='business_weekly_summary'){\n  const s=p.sales||{},f=p.cashFlow,e=p.expenses||{},i=p.inventory||{},b=p.balances||{};\n  lines=[labels[t],'الفترة: '+clean(p.period?.dateFrom)+' — '+clean(p.period?.dateTo),'المبيعات: '+money(s.grossSalesInMinorUnits),'المرتجعات: '+money(s.returnEntitlementInMinorUnits??s.refundsInMinorUnits),'صافي المبيعات: '+money(s.netSalesInMinorUnits),f?'المقبوض كاش: '+money(f.cashCollectedInMinorUnits)+' | CliQ: '+money(f.cliqCollectedInMinorUnits):'تفصيل المقبوض غير متاح في هذا الملخص','المصاريف: '+money(e.totalInMinorUnits),'صافي الربح: '+money(s.netProfitInMinorUnits),'المخزون منخفض: '+clean(i.lowStockCount)+' | نافد: '+clean(i.outOfStockCount),'ذمم الزبائن: '+money(b.customerDueInMinorUnits),'ذمم الموردين: '+money(b.supplierDueInMinorUnits),'https://admin.alnawasreh.com/?screen=reports'];\n }else if(t==='new_order'||['order_unprocessed','order_near_expiry','order_expired'].includes(t)){\n  lines=[labels[t],'رقم الطلب: '+clean(p.orderNumber)];\n  if(t==='new_order')lines.push('الإجمالي: '+money(p.totalInMinorUnits),'الدفع: '+(p.paymentMethod==='cliq'?'CliQ':'كاش عند الاستلام'));\n  if(/^[0-9a-f-]{36}$/i.test($json.entityId||''))lines.push('https://admin.alnawasreh.com/?screen=orders&amp;order='+$json.entityId);\n }else if(t==='low_stock'||t==='out_of_stock')lines=[labels[t],'الصنف: '+clean(p.productName),'المتاح: '+clean(p.availableQuantity),'حد التنبيه: '+clean(p.thresholdQuantity),'المستودع: '+clean(p.warehouseName)];\n else if(t==='shift_closed')lines=[labels[t],'رقم الوردية: '+clean(p.shiftNumber),'المتوقع: '+money(p.expectedCashInMinorUnits),'الفعلي: '+money(p.actualCashInMinorUnits),'فرق الكاش: '+clean(p.cashDiscrepancyDirection)+' '+money(p.cashDiscrepancyAbsoluteInMinorUnits??p.cashDiscrepancyInMinorUnits)];\n else if(t==='shift_close_reminder'||t==='shift_close_overdue')lines=[labels[t],'رقم الوردية: '+clean(p.shiftNumber)];\n else if(t==='purchase_order_overdue')lines=[labels[t],'الرقم: '+clean(p.purchaseOrderNumber),'المورد: '+clean(p.supplierName)];\n else if(t==='expense_daily_threshold')lines=[labels[t],'الفرع: '+clean(p.branchName),'مصروف اليوم: '+money(p.dailyTotalInMinorUnits),'الحد: '+money(p.thresholdInMinorUnits)];\n else if(t==='cheque_due'||t==='cheque_returned')lines=[labels[t],'المرجع: '+clean(p.trackingNumber),'المبلغ: '+money(p.amountInMinorUnits),'الاستحقاق: '+clean(p.dueDate),'https://admin.alnawasreh.com/?screen=cheques'];\n else if(t==='business_alert_recovery'&&labels[p.resolvedAlertType])lines=['تمت معالجة التنبيه: '+labels[p.resolvedAlertType]];\n else throw new Error('OWNER_BUSINESS_EVENT_NOT_ALLOWED');\n return lines.join('\\n');\n})() }}",
                "type": "string"
              }
            ]
          },
          "includeOtherFields": true,
